{
  "name": "dsh-agent-team-scheduler",
  "version": "0.1.1",
  "description": "Scheduler for DeepSeek Harness Agent Teams: dispatches ready, auto-marked board tasks to idle teammates within a WIP limit, without overlapping write scopes, after a human arms it.",
  "license": "MIT",
  "author": "Rinai-R",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinai-R/dsh-agent-team-scheduler.git"
  },
  "homepage": "https://github.com/Rinai-R/dsh-agent-team-scheduler#readme",
  "bugs": {
    "url": "https://github.com/Rinai-R/dsh-agent-team-scheduler/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-teams",
    "scheduler"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-experimental-agent-team": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
